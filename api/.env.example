# Model ID to query. Examples (see https://docs.claude.com/en/docs/about-claude/models):
#   claude-opus-5     - most capable general model ($5 / $25 per 1M tokens)  
#   claude-sonnet-5   - balanced, for high-volume workloads ($2 / $10)
#   claude-haiku-4-5  - fastest/cheapest, simple tasks ($1 / $5) [default]
CLAUDE_MODEL="claude-haiku-4-5"

# Get one at https://console.anthropic.com/settings/keys
# passing via GitHub secrets is recommended for security
# ANTHROPIC_API_KEY=""
